{
  "name": "@inkcraft/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "墨匠 InkCraft 桌面端（Electron）",
  "author": "InkCraft",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "smoke": "electron-vite build && cross-env INKCRAFT_SMOKE=1 electron-vite preview",
    "bench": "electron-vite build && cross-env INKCRAFT_BENCH=1 electron-vite preview",
    "e2e:mock": "electron-vite build && cross-env INKCRAFT_E2E=1 INKCRAFT_E2E_BASE_URL=http://127.0.0.1:8787 INKCRAFT_E2E_PROTOCOL=anthropic INKCRAFT_E2E_API_KEY=test-key INKCRAFT_E2E_NAME=E2E-Mock INKCRAFT_E2E_MODELS=GLM-5.3-Flash electron-vite preview",
    "dist:dir": "pnpm build && electron-builder --win --dir",
    "dist": "pnpm build && electron-builder --win"
  },
  "dependencies": {
    "@inkcraft/core": "workspace:*",
    "@inkcraft/shared": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "docx": "^9.14.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^7.0.3",
    "electron": "43.8.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3"
  }
}
